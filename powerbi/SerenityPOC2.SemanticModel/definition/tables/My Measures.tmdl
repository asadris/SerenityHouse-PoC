table 'My Measures'
	lineageTag: c41cf2f1-3db3-485a-8f34-863700ae0709

	measure 'Active Beds Today' =
			
			VAR TodayKey = CALCULATE(MAX(DimDate[DateKey]), DimDate[FullDate] = TODAY())
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(FactStay[BedKey]),
			    FactStay[IntakeDateKey] <= TodayKey,
			    FactStay[ExitDateKey] >= TodayKey
			)
		lineageTag: 6e6b6a33-ab99-4d19-9e10-7b3740757059

	measure 'Total Beds' = COUNTROWS(DimBed)
		formatString: 0
		lineageTag: 16b19fe8-98a0-47fc-ba6f-96a67d4ecc6c

	measure 'Occupancy %' =
			
			DIVIDE([Active Beds Today], [Total Beds])
		formatString: 0%;-0%;0%
		lineageTag: 85fdf655-bed7-494f-8eda-a48e5cbe5166

	measure 'Bed Status' =
			
			VAR TodayKey = CALCULATE(MAX(DimDate[DateKey]), DimDate[FullDate] = TODAY())
			VAR IsOccupied =
			    CALCULATE(
			        COUNTROWS(FactStay),
			        FactStay[IntakeDateKey] <= TodayKey,
			        FactStay[ExitDateKey] >= TodayKey
			    )
			RETURN
			IF(IsOccupied > 0, "Occupied", "Available")
		lineageTag: c39ff145-d426-403a-8431-8322cb43a4c6

	measure 'Total Charges' =
			
			CALCULATE(
			    SUM(FactRentCharge[Amount]),
			    USERELATIONSHIP(FactRentCharge[ChargeDateKey], DimDate[DateKey]),
			    DimDate[FullDate] <= TODAY()
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Rent
		lineageTag: 4e4040dd-53f6-48bd-96c6-47fd0e28d788

	measure 'Total Payments' =
			
			CALCULATE(
			    SUM(FactRentPayment[Amount]),
			    USERELATIONSHIP(FactRentPayment[PaymentDateKey], DimDate[DateKey]),
			    DimDate[FullDate] <= TODAY()
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Rent
		lineageTag: 6ea2236b-d573-4966-872c-738adc64da16

	measure 'Total Waivers' =
			
			CALCULATE(
			    SUM(FactRentWaiver[Amount]),
			    USERELATIONSHIP(FactRentWaiver[WaiverDateKey], DimDate[DateKey]),
			    DimDate[FullDate] <= TODAY()
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Rent
		lineageTag: 165637a0-88c9-4c43-9e6b-7be90bf89c1e

	measure Arrears =
			
			[Total Charges]
			    - [Total Payments]
			    - [Total Waivers]
			    - [Total Assistance]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Rent
		lineageTag: 51e3829b-6e16-49cd-910e-2f0ef488836a

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Resident Charges' = ```
			
			CALCULATE ( [Total Charges], ALLEXCEPT ( DimResident, DimResident[ResidentKey] ) )
			
			
			```
		displayFolder: Rent
		lineageTag: d27f0a25-00cd-415c-bca6-b2175e548e39

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Resident Payments' = ```
			
			CALCULATE ( [Total Payments], ALLEXCEPT ( DimResident, DimResident[ResidentKey] ) )
			
			
			```
		displayFolder: Rent
		lineageTag: ef95dcd1-4f8a-4a51-95a5-d5bcef5f056c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Resident Waivers' = ```
			
			CALCULATE ( [Total Waivers], ALLEXCEPT ( DimResident, DimResident[ResidentKey] ) )
			
			
			```
		displayFolder: Rent
		lineageTag: 90c67b4c-e21c-4fbb-93be-46515aa8ef6c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Resident Assistance' = ```
			
			CALCULATE ( [Total Assistance], ALLEXCEPT ( DimResident, DimResident[ResidentKey] ) )
			
			
			```
		lineageTag: c8d6dca3-f067-444d-af88-0ddfc2774bda

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Resident Arrears' =
			
			[Resident Charges]
			    - [Resident Payments]
			    - [Resident Waivers]
			    - [Resident Assistance]
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Rent
		lineageTag: e92a2eb3-24a1-4e14-80ee-776d98133ac1

	measure 'Daily Occupancy' =
			
			VAR DateKey = SELECTEDVALUE(DimDate[DateKey])
			RETURN
			COALESCE((CALCULATE(
			    DISTINCTCOUNT(FactStay[StayID]),
			    FactStay[IntakeDateKey] <= DateKey,
			    FactStay[ExitDateKey] >= DateKey,
			    REMOVEFILTERS(DimDate)
			)),0)
		formatString: 0
		lineageTag: 6d9cf908-40d3-47f9-a6a6-371f7e577d49

	measure 'Total Donations' =
			CALCULATE(
			    SUM(FactDonation[Amount]),
			    DimDate[FullDate] <= TODAY()
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 62da3c8c-a53e-44f9-8130-a6392dc892de

	measure 'Total Donors' =
			CALCULATE(
			    DISTINCTCOUNT(FactDonation[DonorID]),
			    DimDate[FullDate] <= TODAY()
			)
		formatString: #,0
		lineageTag: ce0e9c39-63e3-46d6-81ff-c4e4dbd8b852

	measure 'Total Events' =
			CALCULATE(
			    DISTINCTCOUNT(FactDonation[FundraisingEventID]),
			    DimDate[FullDate] <= TODAY()
			)
		formatString: 0
		lineageTag: b4805643-44c4-4a07-a7eb-a68f25e92264

	measure 'Average Donation' =
			CALCULATE(
			    AVERAGE(FactDonation[Amount]),
			    DimDate[FullDate] <= TODAY()
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 3e5754e2-314a-4899-8dc5-5b707b64e696

	measure 'General Fund Donations' =
			
			CALCULATE(
			    [Total Donations],
			    DimFundraisingEvent[IsGeneralFund] = TRUE()
			)
		formatString: 0
		lineageTag: ae688d18-5d3b-4666-8e76-e304353e61e5

	measure 'Event Donations' =
			
			CALCULATE(
			    [Total Donations],
			    DimFundraisingEvent[IsGeneralFund] = 0
			)
		formatString: 0
		lineageTag: f787f4d4-5f1c-4e11-87d3-82ecbfe25862

	measure '% General Fund' =
			
			DIVIDE([General Fund Donations], [Total Donations])
		formatString: 0%;-0%;0%
		lineageTag: f8fd40c9-31fb-42f1-8375-774f4160c007

	measure 'Anonymous Donations' =
			
			CALCULATE(
			    [Total Donations],
			    DimDonor[IsAnonymous] = TRUE()
			)
		formatString: 0
		lineageTag: dd8dcf04-0f7d-404e-9bae-445dd8e4c999

	measure 'YoY Donation Growth' =
			
			VAR CurrentYear = [Total Donations]
			VAR PriorYear =
			    CALCULATE(
			        [Total Donations],
			        DATEADD(DimDate[FullDate], -1, YEAR)
			    )
			RETURN
			DIVIDE(CurrentYear - PriorYear, PriorYear)
		lineageTag: db6780fd-aac5-41d5-b5e2-e004786c595a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Collection Rate %' = DIVIDE([Total Payments], [Total Charges])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Rent
		lineageTag: 04d56387-f830-4d0b-996d-58fc38a84a85

	measure 'Residents With Arrears' =
			
			COUNTROWS(
			    FILTER(
			        VALUES(DimResident[ResidentKey]),
			        [Arrears] > 0
			    )
			)
		formatString: 0
		lineageTag: f6dfa0c3-b35c-4a4d-a54e-c110bae67b65

	measure 'Total Intakes' = ```
			COUNTROWS(FactStay)
			
			
			
			```
		formatString: #,0
		lineageTag: 7bf8f727-4699-4214-96e1-e17acb3736df

	measure 'Court Intake %' =
			
			DIVIDE(
			    CALCULATE(COUNTROWS(FactStay), DimReferralSource[Category] = "Court"),
			    COUNTROWS(FactStay)
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7db252f8-9b39-4c23-8a29-f44a3efc302a

	measure 'Successful Exit Rate' =
			
			DIVIDE(
			    CALCULATE(COUNTROWS(FactStay), FactStay[IsSuccessfulExit] = TRUE(), FactStay[Is Current Stay] = 0),
			    CALCULATE(COUNTROWS(FactStay), FactStay[Is Current Stay] = 0)
			)
		formatString: 0%;-0%;0%
		lineageTag: 79e5c5ed-b286-4e07-8774-5ebda41b54c0

	measure 'Top Referral Source' =
			
			MAXX(
			    TOPN(
			        1,
			        ALL(DimReferralSource),
			        CALCULATE(
			            COUNTROWS(FactStay),
			            FactStay[Is Future Intake] = FALSE()
			        )
			    ),
			    DimReferralSource[Name]
			)
		lineageTag: 0c39a5d6-3aaa-4692-9eda-c093b7e8f409

	measure 'Top Treatment Referral' =
			
			MAXX(
			    TOPN(
			        1,
			        FILTER(ALL(DimReferralSource), DimReferralSource[Category] = "Treatment"),
			        CALCULATE(
			            COUNTROWS(FactStay),
			            FactStay[Is Future Intake] = FALSE()
			        )
			    ),
			    DimReferralSource[Name]
			)
		lineageTag: e172e2ff-1121-422a-8093-ad9487855934

	measure 'Recurring Donor %' =
			
			DIVIDE(
			    CALCULATE(DISTINCTCOUNT(FactDonation[DonorID]), DimDonor[IsRecurring] = TRUE()),
			    DISTINCTCOUNT(FactDonation[DonorID])
			)
		formatString: 0%;-0%;0%
		lineageTag: 4a81c870-fd28-42e2-8efd-b32a07b81b57

	measure 'Residents Assisted' =
			
			CALCULATE(
			    DISTINCTCOUNT(DimResident[ResidentKey]),
			    FactFinancialAssistance
			)
		formatString: #,0
		lineageTag: 8a93e306-bd4e-425e-9a67-c7a48133a3d4

	measure 'Avg Assistance Per Resident' =
			
			DIVIDE([Total Assistance], [Residents Assisted])
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 45818b4b-5264-4c66-bd89-bc9723318266

	measure 'Total Assistance' =

			CALCULATE(
			    SUM(FactFinancialAssistance[Amount]),
			    FactFinancialAssistance[AssistanceDateKey] <= VALUE(FORMAT(TODAY(), "YYYYMMDD"))
			)
		lineageTag: 0db37151-ab35-4fec-8b6a-670ead30a84f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Stays Assisted %' =
			
			DIVIDE(
			    DISTINCTCOUNT(FactFinancialAssistance[StayKey]),
			    COUNTROWS(FactStay)
			)
		formatString: 0%;-0%;0%
		lineageTag: 81e569f2-14a3-4bab-ac02-6002f35da756

	measure 'Total Incidents' =
			
			CALCULATE(
			    COUNTROWS(FactIncident),
			    USERELATIONSHIP(DimDate[DateKey], FactIncident[IncidentDateKey]),
			    DimDate[FullDate] <= TODAY()
			)
		formatString: #,0
		lineageTag: 1f7fa0cc-298a-4e8c-8f9b-03211a6164c8

	measure 'Drug Tests Given' =
			
			CALCULATE(
			    COUNTROWS(FactDrugTest),
			    USERELATIONSHIP(DimDate[DateKey], FactDrugTest[TestDateKey]),
			    DimDate[FullDate] <= TODAY()
			)
		formatString: #,0
		lineageTag: da243c61-9f44-4fe4-8056-523cdadb5a53

	measure 'Positive Test Rate %' =
			
			CALCULATE(
			    DIVIDE(
			        CALCULATE(COUNTROWS(FactDrugTest), FactDrugTest[Result] = "Positive"),
			        COUNTROWS(FactDrugTest)
			    ),
			    USERELATIONSHIP(DimDate[DateKey], FactDrugTest[TestDateKey]),
			    DimDate[FullDate] <= TODAY()
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6608fe25-761a-4b9c-8416-338b22523fa3

	measure 'Most Common Incident' =
			
			MAXX(
			    TOPN(
			        1,
			        ALL(DimIncidentType),
			        CALCULATE(
			            COUNTROWS(FactIncident),
			            FactIncident[Is Future Incident] = FALSE()
			        )
			    ),
			    DimIncidentType[IncidentName]
			)
		lineageTag: 7b04cd86-6dd1-44df-809b-dc347bd86575

	measure 'Incidents Trend' =
			
			CALCULATE(
			    COUNTROWS(FactIncident),
			    USERELATIONSHIP(DimDate[DateKey], FactIncident[IncidentDateKey])
			)
		formatString: 0
		lineageTag: 5e73e7ac-da6d-4258-85ba-cf716f4d0c77

	measure 'Days in Program' =
			VAR LatestIntakeKey =
			    CALCULATE(MAX(FactStay[IntakeDateKey]))
			VAR LatestExitKey =
			    CALCULATE(
			        MAX(FactStay[ExitDateKey]),
			        FactStay[IntakeDateKey] = LatestIntakeKey
			    )
			VAR IsActive =
			    CALCULATE(
			        MAX(FactStay[Is Current Stay]),
			        FactStay[IntakeDateKey] = LatestIntakeKey
			    )
			VAR IntakeDate =
			    LOOKUPVALUE(DimDate[FullDate], DimDate[DateKey], LatestIntakeKey)
			VAR ExitDate =
			    LOOKUPVALUE(DimDate[FullDate], DimDate[DateKey], LatestExitKey)
			VAR EndDate =
			    IF(IsActive = 1, TODAY(), ExitDate)
			RETURN
			IF(
			    NOT ISBLANK(IntakeDate),
			    DATEDIFF(IntakeDate, EndDate, DAY) + 1,
			    BLANK()
			)
		formatString: #,0
		displayFolder: Resident
		lineageTag: a3f2c1d4-7e85-4b9a-9c3d-1f2e8b5a6d7c

	measure 'Intake Date' =
			
			VAR LatestIntakeKey = CALCULATE(MAX(FactStay[IntakeDateKey]))
			RETURN
			LOOKUPVALUE(DimDate[FullDate], DimDate[DateKey], LatestIntakeKey)
		formatString: Short Date
		lineageTag: e2426b74-bd61-4f83-8ec4-6580a2267a99

	measure 'Program Status' =
			
			IF(
			    CALCULATE(MAX(FactStay[Is Current Stay])) = 1,
			    "Active",
			    "Exited"
			)
		lineageTag: 713f909a-55f9-489b-be8b-e0afd3fc43ce

	measure 'Current Stay Arrears' =
			
			CALCULATE(
			    [Arrears],
			    FactStay[Is Current Stay] = 1
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Resident
		lineageTag: b5c8e2a1-9d4f-4b7c-8e3a-2f1c6d9e0b5a

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Incidents Last 30 Days' =
			CALCULATE(
			    COUNTROWS(FactIncident),
			    USERELATIONSHIP(FactIncident[IncidentDateKey], DimDate[DateKey]),
			    DimDate[FullDate] >= TODAY() - 30,
			    DimDate[FullDate] <= TODAY()
			)
		formatString: #,0
		displayFolder: Early Warning
		lineageTag: cad20bc5-3db9-4901-94af-dd1fce0ed4e7

	measure 'Arrears 30 Days Ago' =
			VAR DateKey30 = VALUE(FORMAT(TODAY() - 30, "YYYYMMDD"))
			RETURN
			CALCULATE(
			    SUM(FactRentCharge[Amount]),
			    USERELATIONSHIP(FactRentCharge[ChargeDateKey], DimDate[DateKey]),
			    FactRentCharge[ChargeDateKey] <= DateKey30
			)
			- CALCULATE(
			    SUM(FactRentPayment[Amount]),
			    USERELATIONSHIP(FactRentPayment[PaymentDateKey], DimDate[DateKey]),
			    FactRentPayment[PaymentDateKey] <= DateKey30
			)
			- CALCULATE(
			    SUM(FactRentWaiver[Amount]),
			    USERELATIONSHIP(FactRentWaiver[WaiverDateKey], DimDate[DateKey]),
			    FactRentWaiver[WaiverDateKey] <= DateKey30
			)
			- CALCULATE(
			    SUM(FactFinancialAssistance[Amount]),
			    FactFinancialAssistance[AssistanceDateKey] <= DateKey30
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Early Warning
		lineageTag: 270bebdc-0a3c-4a5d-b330-2c2daa2dad70

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Positive Tests Last 30 Days' =
			CALCULATE(
			    COUNTROWS(FactDrugTest),
			    USERELATIONSHIP(FactDrugTest[TestDateKey], DimDate[DateKey]),
			    DimDate[FullDate] >= TODAY() - 30,
			    DimDate[FullDate] <= TODAY(),
			    FactDrugTest[Result] = "Positive"
			)
		formatString: #,0
		displayFolder: Early Warning
		lineageTag: df409686-666a-4229-9761-d301aa943233

	measure 'Missed Meetings Last 30 Days' =
			CALCULATE(
			    COUNTROWS(FactIncident),
			    USERELATIONSHIP(FactIncident[IncidentDateKey], DimDate[DateKey]),
			    DimDate[FullDate] >= TODAY() - 30,
			    DimDate[FullDate] <= TODAY(),
			    DimIncidentType[IncidentName] = "Incomplete Weekly Meetings"
			)
		formatString: #,0
		displayFolder: Early Warning
		lineageTag: 3583dcff-90bf-4e34-a54f-9a10b1f985bd

	measure 'Arrears Trend' = ```
			
			    IF([Arrears] > [Arrears 30 Days Ago], "↑ Climbing", "Stable")
			```
		lineageTag: 0b5ba0b5-0b0c-4491-8cd5-0e92d3daa2c8

	measure 'Risk Score' =
			
			[Arrears Flag] + [Incidents Flag] + [Positive Tests Flag] + [Missed Meetings Flag]
		formatString: 0
		lineageTag: 4b74ffd4-2d36-4fbc-af91-3f7f8d78e4bf

	measure 'Current Residents' = SUM(FactStay[Is Current Stay])
		formatString: 0
		lineageTag: 8ffdb647-3f40-458e-b91b-7984fedc4473

	measure 'Arrears Trend Color' = ```
			
			    IF([Arrears] > [Arrears 30 Days Ago], "#FFB3B3", "#B3FFB3")
			```
		lineageTag: c7087154-93af-4c65-bb8d-83e4cef7bae4

	measure 'Residents Flagged' =
			
			COUNTROWS(
			    FILTER(
			        VALUES(DimResident[ResidentKey]),
			        [Risk Score] > 0
			    )
			)
		formatString: #,0
		lineageTag: 63d86c3c-5d8a-444d-aeff-c97b39be27e0

	measure '% of House At Risk' =
			
			DIVIDE([Residents Flagged], [Current Residents], 0)
		formatString: 0%;-0%;0%
		lineageTag: 4dbf009d-0abd-4bc0-adb1-b9a25c4756f1

	measure 'Arrears Flag' =
			
			IF([Arrears Trend] = "↑ Climbing" && [Arrears] > 210, 1, 0)
		formatString: 0
		lineageTag: 3db27850-68ce-434f-973a-98736262bc8e

	measure 'Incidents Flag' =
			
			IF([Incidents Last 30 Days] > 0, 2, 0)
		formatString: 0
		lineageTag: e046731d-e42c-4d83-9b12-c2b2b052f306

	measure 'Positive Tests Flag' =
			
			IF([Positive Tests Last 30 Days] > 0, 2, 0)
		formatString: 0
		lineageTag: 6e4da74e-e2cf-49ed-a0c7-6ac067d02284

	measure 'Missed Meetings Flag' =
			
			IF([Missed Meetings Last 30 Days] > 0, 1, 0)
		formatString: 0
		lineageTag: b45af14c-5614-4e83-9de5-9222cf6e3051

	measure 'Incidents Per Month' =
			
			CALCULATE(
			    COUNTROWS(FactIncident),
			    USERELATIONSHIP(FactIncident[IncidentDateKey], DimDate[DateKey]),
			    FactIncident[Is Future Incident] = FALSE()
			)
		formatString: 0
		lineageTag: 4fe3eb53-058f-499c-8432-cbeebd059022

	partition 'My Measures' = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

