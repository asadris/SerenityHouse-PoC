  <DataSets>
    <DataSet Name="dsResidentDropdown">
      <Query>
        <DataSourceName>SerenityDB</DataSourceName>
        <CommandText>SELECT r.ResidentID, r.LastName + ', ' + r.FirstName AS ResidentName
FROM sh.Resident r ORDER BY r.LastName, r.FirstName;</CommandText>
      </Query>
      <Fields>
        <Field Name="ResidentID">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>ResidentID</DataField>
        </Field>
        <Field Name="ResidentName">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ResidentName</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsResidentOverview">
      <Query>
        <DataSourceName>SerenityDB</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ResidentID">
            <Value>=Parameters!ResidentID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT r.FirstName + ' ' + r.LastName AS ResidentName,
       r.DateOfBirth,
       DATEDIFF(YEAR, r.DateOfBirth, GETDATE()) AS Age,
       r.Gender,
       s.IntakeDate,
       s.ExitDate,
       DATEDIFF(DAY, s.IntakeDate, ISNULL(s.ExitDate, GETDATE())) AS LengthOfStayDays,
       CASE WHEN s.ExitDate IS NULL THEN 'Active' ELSE 'Exited' END AS StayStatus,
       rs.SourceName AS ReferralSource,
       cm.FirstName + ' ' + cm.LastName AS CaseManager,
       s.BehavioralCluster,
       s.StayID
FROM   sh.Resident r
JOIN   sh.Stay s ON s.ResidentID = r.ResidentID
LEFT JOIN sh.ReferralSource rs ON rs.ReferralSourceID = s.ReferralSourceID
LEFT JOIN sh.CaseManager cm ON cm.CaseManagerID = s.CaseManagerID
WHERE  r.ResidentID = @ResidentID
  AND  s.IntakeDate = (SELECT MAX(s2.IntakeDate) FROM sh.Stay s2 WHERE s2.ResidentID = r.ResidentID);</CommandText>
      </Query>
      <Fields>
        <Field Name="ResidentName">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ResidentName</DataField>
        </Field>
        <Field Name="DateOfBirth">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>DateOfBirth</DataField>
        </Field>
        <Field Name="Age">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>Age</DataField>
        </Field>
        <Field Name="Gender">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Gender</DataField>
        </Field>
        <Field Name="IntakeDate">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>IntakeDate</DataField>
        </Field>
        <Field Name="ExitDate">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>ExitDate</DataField>
        </Field>
        <Field Name="LengthOfStayDays">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>LengthOfStayDays</DataField>
        </Field>
        <Field Name="StayStatus">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>StayStatus</DataField>
        </Field>
        <Field Name="ReferralSource">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ReferralSource</DataField>
        </Field>
        <Field Name="CaseManager">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CaseManager</DataField>
        </Field>
        <Field Name="BehavioralCluster">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>BehavioralCluster</DataField>
        </Field>
        <Field Name="StayID">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>StayID</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsFinancialSummary">
      <Query>
        <DataSourceName>SerenityDB</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ResidentID">
            <Value>=Parameters!ResidentID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT ISNULL(SUM(rc.AmountCharged),0) AS TotalCharged,
       ISNULL(SUM(rp.AmountPaid),0) AS TotalPaid,
       ISNULL(SUM(rw.AmountWaived),0) AS TotalWaivers,
       ISNULL(SUM(pp.AmountPaid),0) AS TotalAssistance,
       ISNULL(SUM(rc.AmountCharged),0) - ISNULL(SUM(rp.AmountPaid),0)
         - ISNULL(SUM(rw.AmountWaived),0) - ISNULL(SUM(pp.AmountPaid),0) AS Arrears
FROM   sh.Stay s
JOIN   sh.Resident r ON r.ResidentID = s.ResidentID
LEFT JOIN sh.RentCharge rc ON rc.StayID = s.StayID
LEFT JOIN sh.RentPayment rp ON rp.StayID = s.StayID
LEFT JOIN sh.RentWaiver rw ON rw.StayID = s.StayID
LEFT JOIN sh.ProgramPayment pp ON pp.StayID = s.StayID
WHERE  r.ResidentID = @ResidentID
  AND  s.IntakeDate = (SELECT MAX(s2.IntakeDate) FROM sh.Stay s2 WHERE s2.ResidentID = r.ResidentID);</CommandText>
      </Query>
      <Fields>
        <Field Name="TotalCharged">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>TotalCharged</DataField>
        </Field>
        <Field Name="TotalPaid">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>TotalPaid</DataField>
        </Field>
        <Field Name="TotalWaivers">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>TotalWaivers</DataField>
        </Field>
        <Field Name="TotalAssistance">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>TotalAssistance</DataField>
        </Field>
        <Field Name="Arrears">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>Arrears</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsPaymentHistory">
      <Query>
        <DataSourceName>SerenityDB</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ResidentID">
            <Value>=Parameters!ResidentID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT t.TxnDate, t.TxnType, t.Amount, t.Method, t.Note
FROM (
  SELECT rp.PaymentDate AS TxnDate, 'Payment' AS TxnType,
         rp.AmountPaid AS Amount, rp.PaymentMethod AS Method, rp.Notes AS Note, rp.StayID
  FROM sh.RentPayment rp
  UNION ALL
  SELECT rw.WaiverDate, 'Waiver', rw.AmountWaived, NULL, rw.WaiverReason, rw.StayID
  FROM sh.RentWaiver rw
  UNION ALL
  SELECT pp.PaymentDate, 'Assistance', pp.AmountPaid, fap.ProgramName, pp.Notes, pp.StayID
  FROM sh.ProgramPayment pp
  JOIN sh.FinancialAssistanceProgram fap ON fap.ProgramID = pp.ProgramID
) t
JOIN sh.Stay s ON s.StayID = t.StayID
WHERE s.ResidentID = @ResidentID
  AND s.IntakeDate = (SELECT MAX(s2.IntakeDate) FROM sh.Stay s2 WHERE s2.ResidentID = s.ResidentID)
ORDER BY t.TxnDate DESC;</CommandText>
      </Query>
      <Fields>
        <Field Name="TxnDate">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>TxnDate</DataField>
        </Field>
        <Field Name="TxnType">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>TxnType</DataField>
        </Field>
        <Field Name="Amount">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>Amount</DataField>
        </Field>
        <Field Name="Method">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Method</DataField>
        </Field>
        <Field Name="Note">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Note</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsIncidents">
      <Query>
        <DataSourceName>SerenityDB</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ResidentID">
            <Value>=Parameters!ResidentID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT i.IncidentDate, it.TypeName AS IncidentType, it.Severity,
       i.ActionTaken, ISNULL(i.Description, '—') AS Description
FROM   sh.Incident i
JOIN   sh.IncidentType it ON it.IncidentTypeID = i.IncidentTypeID
JOIN   sh.Stay s ON s.StayID = i.StayID
WHERE  s.ResidentID = @ResidentID
  AND  s.IntakeDate = (SELECT MAX(s2.IntakeDate) FROM sh.Stay s2 WHERE s2.ResidentID = s.ResidentID)
ORDER BY i.IncidentDate DESC;</CommandText>
      </Query>
      <Fields>
        <Field Name="IncidentDate">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>IncidentDate</DataField>
        </Field>
        <Field Name="IncidentType">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>IncidentType</DataField>
        </Field>
        <Field Name="Severity">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Severity</DataField>
        </Field>
        <Field Name="ActionTaken">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ActionTaken</DataField>
        </Field>
        <Field Name="Description">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Description</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsDrugTests">
      <Query>
        <DataSourceName>SerenityDB</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ResidentID">
            <Value>=Parameters!ResidentID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT dt.TestDate, dt.TestType, dt.Result,
       CASE WHEN dt.IsRandom = 1 THEN 'Yes' ELSE 'No' END AS IsRandom,
       ISNULL(dt.SubstancesDetected, '—') AS SubstancesDetected
FROM   sh.DrugTest dt
JOIN   sh.Stay s ON s.StayID = dt.StayID
WHERE  s.ResidentID = @ResidentID
  AND  s.IntakeDate = (SELECT MAX(s2.IntakeDate) FROM sh.Stay s2 WHERE s2.ResidentID = s.ResidentID)
ORDER BY dt.TestDate DESC;</CommandText>
      </Query>
      <Fields>
        <Field Name="TestDate">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>TestDate</DataField>
        </Field>
        <Field Name="TestType">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>TestType</DataField>
        </Field>
        <Field Name="Result">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Result</DataField>
        </Field>
        <Field Name="IsRandom">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>IsRandom</DataField>
        </Field>
        <Field Name="SubstancesDetected">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>SubstancesDetected</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
